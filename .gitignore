# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==============================
# Node.js / backend dependencies
# ==============================
/backend/node_modules
/backend/.pnp
backend/.pnp.*
backend/.yarn/*
!backend/.yarn/patches
!backend/.yarn/plugins
!backend/.yarn/releases
!backend/.yarn/versions

# ==============================
# Python / ml-service
# ==============================
/ml-service/venv
/ml-service/.venv
/ml-service/__pycache__
/ml-service/**/__pycache__
/ml-service/*.pyc
/ml-service/.pytest_cache
/ml-service/.coverage
/ml-service/htmlcov
/ml-service/dist
/ml-service/build
/ml-service/*.egg-info
/ml-service/.mypy_cache
/ml-service/.ruff_cache

# ==============================
# testing
# ==============================
/coverage

# ==============================
# production
# ==============================
/build
/dist

# ==============================
# misc
# ==============================
.DS_Store
*.pem
*.log
Thumbs.db

# ==============================
# debug logs
# ==============================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==============================
# env files (can opt-in for committing if needed)
# ==============================
.env
.env.*
!.env.example

# ==============================
# IDE / editor
# ==============================
.idea/
.vscode/
*.swp
*.swo
*~

# ==============================
# Python
# ==============================
*.py[cod]
*.egg
.eggs/
.ropeproject/

# ==============================
# TypeScript / JavaScript
# ==============================
*.tsbuildinfo

# ==============================
# OS generated files
# ==============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================
